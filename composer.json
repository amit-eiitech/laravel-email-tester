{
  "name": "eii/laravel-email-tester",
  "description": "Command-line email delivery tester for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",
  "require": {
    "php": "^8.3",
    "illuminate/console": "^13.0",
    "illuminate/log": "^13.0",
    "illuminate/mail": "^13.0",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Eii\\LaravelEmailTester\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Eii\\LaravelEmailTester\\LaravelEmailTesterServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
